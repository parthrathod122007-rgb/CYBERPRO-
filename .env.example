# ==============================================================================
# CYBERPRO ZERO-TRUST PLATFORM & AI CRM - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the server in production.
# NEVER commit actual secrets, production passwords, or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
CYBERPRO_HOST=127.0.0.1           # Set to 0.0.0.0 in Docker or production behind reverse proxy
CYBERPRO_PORT=8000                # HTTP service port (default: 8000)
CYBERPRO_DB=./data/cyberpro.db    # SQLite database file path (created automatically if missing)
CYBERPRO_SESSION_HOURS=12         # Authenticated session token lifetime in hours
CYBERPRO_COOKIE_SECURE=0          # Set to 1 in production over HTTPS (forces Secure flag on cookie)
CYBERPRO_TRUST_PROXY=0            # Set to 1 only when deployed behind Nginx / Cloudflare reverse proxy

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE TURNSTILE HUMAN DEFENSE (BOT & BRUTE FORCE SHIELD)
# ------------------------------------------------------------------------------
# Obtain production keys from Cloudflare Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# Default test keys below will ALWAYS PASS (for development & sandbox testing):
#   Site Key:   1x00000000000000000000AA
#   Secret Key: 1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_ENABLED=1

# ------------------------------------------------------------------------------
# 3. AI ASSISTANT & CHATBOT CONFIGURATION (OPTIONAL EXTERNAL PROVIDERS)
# ------------------------------------------------------------------------------
# If left blank, the built-in CYBERPRO Neural Inference Engine operates locally
# with zero external API dependencies.
# To connect to external LLMs, provide the appropriate API key below:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
