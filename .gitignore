# Environments & Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.pem
*.key

# SQLite Database binaries (keep schema.sql in git instead)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.log
*.log

