*.py[cod]
*$py.class
.pytest_cache/

# Node & Build artifacts
node_modules/
dist/
.vite/

# Temporary / Scratch scripts
scratch/

# Local archives
*.zip
*.tar.gz

# OS generated files
.DS_Store
Thumbs.db
